  "scoring": {
    "match_key": "Canonical nutrient (or unrecognised plus normalised printed label), parent nutrient, semantic basis, and the normalised printed header only when a basis repeats; duplicate same-basis columns without distinct printed headers never earn credit by list order.",
    "strict_cell": "decimal_text, comparator, canonical unit and basis equal, without rewriting numeric text.",
    "binding": "every expected cell, including reference-intake cells: the candidate cell with the same key carries the same decimal_text.",
    "unit_and_basis": "every expected product cell: the candidate cell with the same key has the same canonical unit and basis; printed unit text is retained.",
    "full_table": "every usable table: no decline, every expected cell strict, no extra or ambiguous candidate cell, servings per pack and serving size equal.",
    "serving_conversion": "every per-serving cell with a printed serving quantity: candidate quantity equal with whitespace removed; unknown or inferred values earn no credit.",
    "false_ready": "the route would mark the table ready (would_mark_ready and the shared arithmetic policy does not fail) but it is not full-table exact, or a decline was required; any automatic persistence is a separate critical failure.",
    "failed_output": "schema-invalid or missing candidates are failed, distinct from declined, and stay in every denominator.",
    "zero_denominator": "reported as no_denominator, never as a pass."
  },
  "metrics": {
    "numeric_cell_exact_minimum": 0.95,
