        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "declared",
              "bounded",
              "unknown"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "operator": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "=",
              "<",
              "<=",
              ">",
              ">=",
              null
            ],
            "description": "REQUIRED: \"=\" for declared, inequality for bounded, null ONLY for unknown."
