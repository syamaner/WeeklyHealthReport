    "reason": {
      "type": "string"
    },
    "applicability": {
      "type": "string",
      "enum": [
        "source_record",
        "representative",
        "unresolved"
      ],
      "description": "source_record for explicitly matching product OR user-selected composition record, even if an average; representative for a vague query matched to an example."
